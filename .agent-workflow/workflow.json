{
  "schema": 3,
  "stages": [
    {
      "id": "planning",
      "executor": "main",
      "writes": [
        "specs/**"
      ],
      "next": "gate_spec"
    },
    {
      "id": "gate_spec",
      "executor": "human",
      "writes": [],
      "next": "feasibility"
    },
    {
      "id": "feasibility",
      "executor": "agent:solution-architect",
      "writes": [
        "specs/**"
      ],
      "next": "gate_approach"
    },
    {
      "id": "gate_approach",
      "executor": "human",
      "writes": [],
      "next": "tests"
    },
    {
      "id": "tests",
      "executor": "agent:test-architect",
      "writes": [
        "<product_test_globs>"
      ],
      "next": "gate_tests"
    },
    {
      "id": "gate_tests",
      "executor": "human",
      "writes": [],
      "next": "implement"
    },
    {
      "id": "implement",
      "executor": "agent:implementer",
      "writes": [
        "<src_globs>",
        "<unit_test_globs>",
        "!<product_test_globs>"
      ],
      "max_attempts": 5,
      "next": "review"
    },
    {
      "id": "review",
      "executor": "agent:code-reviewer",
      "writes": [
        "<src_globs>",
        "<unit_test_globs>",
        "!<product_test_globs>",
        "<run_dir>"
      ],
      "max_rounds": 3,
      "next": "gate_review"
    },
    {
      "id": "gate_review",
      "executor": "human",
      "writes": [],
      "on_reject": "implement",
      "next": "verify"
    },
    {
      "id": "verify",
      "executor": "agent:verifier",
      "writes": [
        "<run_dir>"
      ],
      "max_fix_rounds": 2,
      "next": "gate_final"
    },
    {
      "id": "gate_final",
      "executor": "human",
      "writes": [],
      "next": "pr"
    },
    {
      "id": "pr",
      "executor": "main",
      "writes": [],
      "next": "done"
    }
  ],
  "guarded_shell_patterns": [
    "(^|[;&|(`\\n]|\\$\\()\\s*git(\\s+(-c|-C)\\s+\\S+|\\s+--[\\w-]+(=\\S+)?)*\\s+commit(?![\\w-])",
    "(^|[;&|(`\\n]|\\$\\()\\s*git(\\s+(-c|-C)\\s+\\S+|\\s+--[\\w-]+(=\\S+)?)*\\s+push(?![\\w-])",
    "(^|[;&|(`\\n]|\\$\\()\\s*gh\\s+pr\\s+create(?![\\w-])"
  ],
  "protected_files": [
    ".agent-workflow/state.json",
    ".agent-workflow/workflow.json",
    ".agent-workflow/project.json"
  ],
  "profiles": {
    "full": {
      "adr": true
    },
    "pm": {
      "skip": [
        "feasibility",
        "gate_approach",
        "tests",
        "gate_tests",
        "implement",
        "review",
        "gate_review",
        "verify"
      ],
      "auto": {
        "gate_final": "specs_only_unchanged"
      },
      "pr_paths": [
        "specs/spec-<id>/**"
      ],
      "adr": false
    },
    "dev": {
      "auto": {
        "gate_spec": "planning_clean",
        "gate_approach": "approach_low_risk",
        "gate_tests": "red_for_right_reason",
        "gate_review": "no_open_high_or_decision"
      },
      "min_approaches": 1,
      "loop_caps": {
        "grill": 2
      },
      "min_automated_test_cases": 1,
      "adr": false
    },
    "docs": {
      "skip": [
        "feasibility",
        "gate_approach",
        "tests",
        "gate_tests"
      ],
      "auto": {
        "gate_review": "no_open_high_or_decision"
      },
      "writes": {
        "implement": [
          "<docs_globs>"
        ],
        "review": [
          "<docs_globs>",
          "<run_dir>"
        ]
      },
      "verify_tiers": [
        "docs_lint",
        "links"
      ],
      "adr": false
    }
  }
}
