{
  "product_test_globs": [
    "E2E/tests/**"
  ],
  "unit_test_globs": [
    "tests/**/*.py",
    "**/*.test.ts",
    "**/*.test.js"
  ],
  "src_globs": [
    "src/**"
  ],
  "commands": {
    "unit": "",
    "lint": "",
    "typecheck": "",
    "format": "",
    "complexity": "",
    "seed": "",
    "e2e": "",
    "a11y": "",
    "docs_lint": "",
    "links": ""
  },
  "surfaces": [
    "ui",
    "api"
  ],
  "dev_url": "http://localhost:3000",
  "loop_caps": {
    "grill": 5,
    "implement": 5,
    "review": 3,
    "verify_fix": 2
  },
  "telemetry": {
    "enabled": true,
    "server_url": "",
    "required": false
  },
  "docs_globs": [
    "docs/**",
    "**/*.md"
  ]
}
