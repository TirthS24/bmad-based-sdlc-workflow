# macOS
.DS_Store
**/.DS_Store

# Live workflow state. Archived copies live under runs/ and stay local.
.agent-workflow/state.json
.agent-workflow/events.jsonl
.agent-workflow/runs/

# BMAD per-user install answers (regenerated by the installer)
_bmad/config.user.toml
_bmad/**/*.user.toml

# Local dependencies
node_modules/

# Local telemetry queue (events wait here until the server acknowledges them)
.agent-workflow/queue/

# Playwright output from the server test run
server/test-results/
server/playwright-report/
